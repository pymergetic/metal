---
# Generated to .clangd by scripts/setup ide (@@ROOT@@ → absolute checkout path).
# EDK2 headers live under external/edk2 (run ./scripts/setup edk2).
# After regenerating or editing this template: restart clangd
# (Command Palette → "clangd: Restart language server") or reload the window.

CompileFlags:
  Compiler: /usr/bin/clang
  Add:
    - -std=c11
    - -I@@ROOT@@
    - -I@@ROOT@@/include
    # Baked CA pubs for trust.c (#include "metal_trust_bake.inc.c")
    - -I@@ROOT@@/build/trust
    # Always visible: Metal WAMR platform + freestanding libc stubs.
    - -I@@ROOT@@/src/pymergetic/metal/guest/wamr
    - -I@@ROOT@@/src/pymergetic/metal/runtime/mem/host_stubs
    - -I@@ROOT@@/external/wamr/core/shared/platform/include
    # Always visible so quoted WAMR platform includes resolve even if a
    # PathMatch fragment is skipped (clangd matches absolute paths).
    - -I@@ROOT@@/src/pymergetic/metal/guest/wamr
    - -I@@ROOT@@/external/wamr/core/shared/platform/include
    - -I@@ROOT@@/src/pymergetic/metal/runtime/mem/host_stubs
    # MicroPython embed (metal/py glue); PathMatch alone is easy to miss.
    - -I@@ROOT@@/build/micropython_embed
    - -I@@ROOT@@/build/micropython_embed/port
    - -I@@ROOT@@/build/micropython_embed/genhdr
    - -I@@ROOT@@/src/pymergetic/metal/py/embed
    - -I@@ROOT@@/external/micropython
    - -I@@ROOT@@/external/micropython/lib/libm
    - -DMICROPY_USE_INTERNAL_ERRNO=1
    # lwIP -I lives in efi/bios PathMatch + CDB only — a global EFI net -I
    # steals bios/.../dev/net (wrong lwipopts.h / PmBiosUefi.h).

---
# metal.efi sources — EDK2 MdePkg (clangd; real build is EDK2 `build`).
# CompilationDatabase None: clangd otherwise fuzzy-matches same basenames
# (virtio_snd.c, net_lwip.c, …) to the BIOS CDB entry and drops Uefi.h.
# PathMatch is unanchored so it matches absolute URIs/paths too.
If:
  PathMatch: .*/src/efi/.*\.(c|h)$
CompileFlags:
  CompilationDatabase: "None"
  Compiler: /usr/bin/clang
  Add:
    - -std=c11
    - -ffreestanding
    - -fno-stack-protector
    - -target
    - x86_64-unknown-windows
    - "-DEFIAPI=__attribute__((ms_abi))"
    - -I@@ROOT@@/external/edk2/MdePkg/Include
    - -I@@ROOT@@/external/edk2/MdePkg/Include/X64
    - -I@@ROOT@@/src/pymergetic/metal/runtime/mem/host_stubs
    - -I@@ROOT@@/external/tlsf
    - -I@@ROOT@@/include
    - -I@@ROOT@@/src/pymergetic/metal
    - -I@@ROOT@@/src/efi/MetalPkg
    - -I@@ROOT@@/src/efi/pymergetic/metal/mem
    - -I@@ROOT@@/src/pymergetic/metal/dev/net
    - -I@@ROOT@@/src/pymergetic/metal/net/ip
    - -I@@ROOT@@/external/lwip/src/include
    - -I@@ROOT@@/external/mbedtls/include
    - '-DMBEDTLS_CONFIG_FILE=<pymergetic/metal/net/tls/mbedtls_metal_config.h>'
    - -I@@ROOT@@/src/pymergetic/metal/guest/wamr
    - -I@@ROOT@@/external/wamr/core/shared/platform/include
    - -I@@ROOT@@/external/wamr/core/shared/utils
    - -I@@ROOT@@/external/wamr/core/iwasm/include
    - -I@@ROOT@@/external/wamr/core/iwasm/libraries/libc-wasi/sandboxed-system-primitives/include
    - -DBH_PLATFORM_METAL_EFI
    - -DAPP_THREAD_STACK_SIZE_DEFAULT=6144
    - -DAPP_THREAD_STACK_SIZE_MIN=4096
    - -DBUILD_TARGET_X86_64
    - -DWASM_ENABLE_LIBC_WASI=1

---
# Metal contracts + EFI binds
If:
  PathMatch: .*/src/(pymergetic|efi/pymergetic)/metal/.*\.(c|h)$
CompileFlags:
  CompilationDatabase: "None"
  Compiler: /usr/bin/clang
  Add:
    - -std=c11
    - -ffreestanding
    - -fno-stack-protector
    - -target
    - x86_64-unknown-windows
    - "-DEFIAPI=__attribute__((ms_abi))"
    - -I@@ROOT@@/build/trust
    - -I@@ROOT@@/external/edk2/MdePkg/Include
    - -I@@ROOT@@/external/edk2/MdePkg/Include/X64
    - -I@@ROOT@@/src/pymergetic/metal/runtime/mem/host_stubs
    - -I@@ROOT@@/external/tlsf
    - -I@@ROOT@@/include
    - -I@@ROOT@@/src/pymergetic/metal
    - -I@@ROOT@@/src/efi/pymergetic/metal/mem
    - -I@@ROOT@@/src/pymergetic/metal/dev/net
    - -I@@ROOT@@/src/pymergetic/metal/net/ip
    - -I@@ROOT@@/external/lwip/src/include
    - -I@@ROOT@@/external/mbedtls/include
    - '-DMBEDTLS_CONFIG_FILE=<pymergetic/metal/net/tls/mbedtls_metal_config.h>'
    - -I@@ROOT@@/src/pymergetic/metal/guest/wamr
    - -I@@ROOT@@/external/wamr/core/shared/platform/include
    - -I@@ROOT@@/external/wamr/core/shared/utils
    - -I@@ROOT@@/external/wamr/core/iwasm/include
    - -I@@ROOT@@/external/wamr/core/iwasm/libraries/libc-wasi/sandboxed-system-primitives/include
    - -DBH_PLATFORM_METAL_EFI
    - -DAPP_THREAD_STACK_SIZE_DEFAULT=6144
    - -DAPP_THREAD_STACK_SIZE_MIN=4096
    - -DBUILD_TARGET_X86_64
    - -DWASM_ENABLE_LIBC_WASI=1

---
# MicroPython glue — embed package (py/*.h, genhdr, port, mpconfigport).
If:
  PathMatch: .*/src/pymergetic/metal/py/.*\.(c|h)$
CompileFlags:
  Add:
    - -I@@ROOT@@/build/micropython_embed
    - -I@@ROOT@@/build/micropython_embed/port
    - -I@@ROOT@@/build/micropython_embed/genhdr
    - -I@@ROOT@@/src/pymergetic/metal/py/embed
    - -I@@ROOT@@/external/micropython
    - -I@@ROOT@@/external/micropython/lib/libm
    - -DMICROPY_USE_INTERNAL_ERRNO=1

---
# EFI WAMR platform .c — full EDK2 -I (never BIOS sibling CDB).
If:
  PathMatch: .*/src/pymergetic/metal/guest/wamr/.*\.(c|h)$
CompileFlags:
  CompilationDatabase: "None"
  Compiler: /usr/bin/clang
  Add:
    - -I@@ROOT@@/external/edk2/MdePkg/Include
    - -I@@ROOT@@/external/edk2/MdePkg/Include/X64
    - -I@@ROOT@@/src/pymergetic/metal/guest/wamr
    - -I@@ROOT@@/external/wamr/core/shared/platform/include
    - -I@@ROOT@@/src/pymergetic/metal/runtime/mem/host_stubs
    - -I@@ROOT@@/external/wamr/core/shared/utils
    - -I@@ROOT@@/external/wamr/core/iwasm/include
    - -I@@ROOT@@/external/wamr/core/iwasm/libraries/libc-wasi/sandboxed-system-primitives/include
    - -I@@ROOT@@/include
    - -I@@ROOT@@/src/pymergetic/metal
    - -DBH_PLATFORM_METAL_EFI
    - -DAPP_THREAD_STACK_SIZE_DEFAULT=6144
    - -DAPP_THREAD_STACK_SIZE_MIN=4096
    - -DBUILD_TARGET_X86_64
    - -DWASM_ENABLE_LIBC_WASI=1

---
# EFI net / lwIP + mbedTLS — full EDK2 -I (never BIOS sibling CDB).
If:
  PathMatch: .*/src/pymergetic/metal/dev/net/.*\.(c|h)$
CompileFlags:
  CompilationDatabase: "None"
  Compiler: /usr/bin/clang
  Add:
    - -std=c11
    - -ffreestanding
    - -fno-stack-protector
    - -target
    - x86_64-unknown-windows
    - "-DEFIAPI=__attribute__((ms_abi))"
    - -I@@ROOT@@/external/edk2/MdePkg/Include
    - -I@@ROOT@@/external/edk2/MdePkg/Include/X64
    - -I@@ROOT@@/src/pymergetic/metal/dev/net
    - -I@@ROOT@@/src/pymergetic/metal/net/ip
    - -I@@ROOT@@/external/lwip/src/include
    - -I@@ROOT@@/external/mbedtls/include
    - '-DMBEDTLS_CONFIG_FILE=<pymergetic/metal/net/tls/mbedtls_metal_config.h>'
    - -I@@ROOT@@/src/pymergetic/metal/runtime/mem/host_stubs
    - -I@@ROOT@@/include
    - -I@@ROOT@@/src/pymergetic/metal
    - -DBH_PLATFORM_METAL_EFI
    - -DBUILD_TARGET_X86_64

---
# Dropbear glue + freestanding POSIX stubs. Must run after the net fragment
# so we can Remove host_stubs and re-Add stubs first (same order as
# DropbearGlue.inf / bios DROPBEAR_EXTRA_CFLAGS).
If:
  PathMatch: .*/src/pymergetic/metal/dev/net/(dropbear_stubs/|dropbear_metal/|dropbear_|ssh_dropbear).*
CompileFlags:
  CompilationDatabase: "None"
  Compiler: /usr/bin/clang
  Remove:
    - -I@@ROOT@@/src/pymergetic/metal/runtime/mem/host_stubs
  Add:
    - -DDROPBEAR_METAL=1
    - -DLOCALOPTIONS_H_EXISTS=1
    - -DBUNDLED_LIBTOM=1
    - -DUSE_LTM
    - -DLTM_DESC
    - -I@@ROOT@@/src/pymergetic/metal/net/ssh/dropbear_metal
    - -I@@ROOT@@/src/pymergetic/metal/net/ssh/dropbear_stubs
    - -I@@ROOT@@/src/pymergetic/metal
    - -I@@ROOT@@/src/pymergetic/metal/dev/net
    - -I@@ROOT@@/src/pymergetic/metal/net/ip
    - -I@@ROOT@@/src/pymergetic/metal/runtime/mem/host_stubs
    - -I@@ROOT@@/external/dropbear/src
    - -I@@ROOT@@/external/dropbear/libtomcrypt/src/headers
    - -I@@ROOT@@/external/dropbear/libtommath
    - -I@@ROOT@@/external/lwip/src/include
    - -I@@ROOT@@/external/mbedtls/include
    - '-DMBEDTLS_CONFIG_FILE=<pymergetic/metal/net/tls/mbedtls_metal_config.h>'

---
# Vendored Dropbear TUs (external/dropbear/src) — Metal freestanding build,
# not host autoconf. config.h / localoptions live under dropbear_metal/;
# POSIX types under dropbear_stubs/. Same flag set as dropbear.sh.
If:
  PathMatch: .*/external/dropbear/src/.*\.(c|h)$
CompileFlags:
  CompilationDatabase: "None"
  Compiler: /usr/bin/clang
  Remove:
    - -I@@ROOT@@/src/pymergetic/metal/runtime/mem/host_stubs
  Add:
    - -std=c11
    - -ffreestanding
    - -fno-stack-protector
    - -target
    - x86_64-unknown-windows
    - "-DEFIAPI=__attribute__((ms_abi))"
    - -DDROPBEAR_METAL=1
    - -DDROPBEAR_SERVER=1
    - -DLOCALOPTIONS_H_EXISTS=1
    - -DBUNDLED_LIBTOM=1
    - -DUSE_LTM
    - -DLTM_DESC
    - -I@@ROOT@@/src/pymergetic/metal/net/ssh/dropbear_metal
    - -I@@ROOT@@/src/pymergetic/metal/net/ssh/dropbear_stubs
    - -I@@ROOT@@/src/pymergetic/metal/runtime/mem/host_stubs
    - -I@@ROOT@@/src/pymergetic/metal
    - -I@@ROOT@@/src/pymergetic/metal/dev/net
    - -I@@ROOT@@/src/pymergetic/metal/net/ip
    - -I@@ROOT@@/include
    - -I@@ROOT@@/external/dropbear/src
    - -I@@ROOT@@/external/dropbear/libtomcrypt/src/headers
    - -I@@ROOT@@/external/dropbear/libtommath
    - -I@@ROOT@@/external/lwip/src/include
    - -I@@ROOT@@/external/mbedtls/include
    - '-DMBEDTLS_CONFIG_FILE=<pymergetic/metal/net/tls/mbedtls_metal_config.h>'

---
# Metal BIOS freestanding shim (not EDK2) — Multiboot metal.elf / metal.boot.elf.
# CompilationDatabase None: clangd otherwise fuzzy-matches same basenames
# (net_lwip.c, virtio_blk.c, …) to the EFI CDB entry and drops PmBiosUefi.h.
If:
  PathMatch: .*/src/bios/.*\.(c|h|S)$
CompileFlags:
  CompilationDatabase: "None"
  Compiler: /usr/bin/clang
  Add:
    - -std=c11
    - -ffreestanding
    - -fno-stack-protector
    - -m64
    - -I@@ROOT@@/src/bios/shim
    - -I@@ROOT@@/include
    - -I@@ROOT@@/src/pymergetic/metal
    - -I@@ROOT@@/src/pymergetic/metal/dev/net
    - -I@@ROOT@@/src/pymergetic/metal/net/ip
    - -I@@ROOT@@/external/lwip/src/include
    - -I@@ROOT@@/external/mbedtls/include
    - '-DMBEDTLS_CONFIG_FILE=<pymergetic/metal/net/tls/mbedtls_metal_config.h>'
    - -I@@ROOT@@/src/bios/pymergetic/metal/guest/wamr
    - -I@@ROOT@@/src/bios/pymergetic/metal/runtime/mem/host_stubs
    - -I@@ROOT@@/external/wamr/core/iwasm/include
    - -I@@ROOT@@/external/wamr/core/shared/platform/include
    - -I@@ROOT@@/external/wamr/core/shared/utils
    - -DBH_PLATFORM_METAL_BIOS
    - -DBH_PLATFORM_METAL_EFI
    - -DAPP_THREAD_STACK_SIZE_DEFAULT=6144
    - -DAPP_THREAD_STACK_SIZE_MIN=4096
    - -DBUILD_TARGET_X86_64
    - -DWASM_ENABLE_LIBC_WASI=1

---
# Host-side regressions (Linux glibc) — not freestanding host_stubs / WASI.
# Also mirrored in tests/host/.clangd (closer config; PathMatch alone was
# insufficient against CDB fuzzy-match to wasm).
If:
  PathMatch: [/.]tests/host/.*\.(c|h)$
CompileFlags:
  CompilationDatabase: "None"
  Compiler: /usr/bin/clang
  Remove:
    - -I@@ROOT@@/src/pymergetic/metal/runtime/mem/host_stubs
    - -I@@ROOT@@/src/pymergetic/metal/guest/wamr
    - -I@@ROOT@@/external/wamr/core/shared/platform/include
    - --target=*
    - --sysroot=*
  Add:
    - --target=x86_64-linux-gnu
    - -std=c11
    - -D_GNU_SOURCE
    - -I@@ROOT@@/external/tlsf
    - -I@@ROOT@@/include

---
# Guest test mods (wasm) — optional; needs ./scripts/setup tools for wasi-sysroot.
If:
  PathMatch: .*/mods/tests/.*\.c
CompileFlags:
  CompilationDatabase: "None"
  Compiler: /usr/bin/clang
  Add:
    - --target=wasm32-wasip1
    - --sysroot
    - "@@ROOT@@/.tools/wasi-sdk/share/wasi-sysroot"
    - -I@@ROOT@@/include

---
# Vendored trees stay upstream-vanilla. IncludeCleaner (and friends) must not
# push "remove unused include" / style fixes into external/ — Metal shims and
# patches/<dep>/ only. See docs/SOURCETREE.md § Vendoring.
# PathMatch is relative to this .clangd's directory (clangd project config).
If:
  PathMatch: external/.*
Diagnostics:
  UnusedIncludes: None
  MissingIncludes: None
  ClangTidy:
    Remove: '*'
Index:
  Background: Skip
