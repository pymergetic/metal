---
# Copied to .clangd by scripts/setup ide. Paths are repo-relative (no abs).
# Live product is src/; archived product is under _old/ (no PathMatch here).
# After editing: restart clangd (Command Palette -> "clangd: Restart language server").

CompileFlags:
  Compiler: /usr/bin/clang
  Add:
    - -xc
    - -std=c11
    - -I.
    - -Isrc
    - -Isrc/pymergetic/metal/libc
    - -Iexternal/tlsf
    - -Iexternal/lwip/src/include

---
# Live — freestanding ISO C.
# Split .c/.h — avoid `|` in PathMatch (YAML/clangd footgun).
If:
  PathMatch: .*/src/.*\.c$
CompileFlags:
  Compiler: /usr/bin/clang
  Remove:
    - -Isrc/pymergetic/metal
  Add:
    - -xc
    - -std=c11
    - -ffreestanding
    - -nostdinc
    - -fno-stack-protector
    - -m64
    - -mno-red-zone
    - -Isrc/pymergetic/metal/libc
    - -Isrc
    - -Isrc/pymergetic/metal/net/ip
    - -Isrc/pymergetic/metal/net/ip/cfg
    - -Iexternal/lwip/src/include

---
# Package-root stress harness (same -I set as forge --stress).
If:
  PathMatch: .*/stress/.*\.c$
CompileFlags:
  Compiler: /usr/bin/clang
  Add:
    - -xc
    - -std=c11
    - -ffreestanding
    - -nostdinc
    - -fno-stack-protector
    - -m64
    - -mno-red-zone
    - -DEXP2_STRESS=1
    - -DPM_METAL_BOOT_TARGET_BIOS=1
    - -Ibuild
    - -Isrc/pymergetic/metal/libc
    - -Isrc
    - -Isrc/pymergetic/metal/net/ip
    - -Isrc/pymergetic/metal/net/ip/cfg
    - -Iexternal/lwip/src/include
    - -Isrc/pymergetic/metal/boot/platform/bios

---
If:
  PathMatch: .*/src/.*\.h$
CompileFlags:
  Compiler: /usr/bin/clang
  Remove:
    - -Isrc/pymergetic/metal
  Add:
    - -xc
    - -std=c11
    - -ffreestanding
    - -nostdinc
    - -fno-stack-protector
    - -m64
    - -mno-red-zone
    - -Isrc/pymergetic/metal/libc
    - -Isrc
    - -Isrc/pymergetic/metal/net/ip
    - -Isrc/pymergetic/metal/net/ip/cfg
    - -Iexternal/lwip/src/include

---
# littlefs glue — LFS_CONFIG + vendor (repo-relative -I).
If:
  PathMatch: .*/src/pymergetic/metal/fs/littlefs/
CompileFlags:
  Add:
    - -Isrc/pymergetic/metal/fs/littlefs
    - -Isrc/pymergetic/metal/fs/littlefs/vendor
    - -DLFS_CONFIG=lfs_config.h
    - -DPM_METAL_LFS_FREESTANDING

---
# Dropbear SSH glue — dropbear_stubs before metal/libc (errno/malloc/strrchr).
If:
  PathMatch: .*/src/pymergetic/metal/net/ssh/
CompileFlags:
  Remove:
    - -Isrc/pymergetic/metal/libc
  Add:
    - -std=gnu11
    - -Isrc/pymergetic/metal/net/ssh/dropbear_stubs
    - -Isrc/pymergetic/metal/libc
    - -Isrc/pymergetic/metal/net/ssh
    - -Isrc/pymergetic/metal/net/ssh/dropbear_metal
    - -Iexternal/dropbear/src
    - -Isrc/pymergetic/metal
    - -DDROPBEAR_SERVER=1
    - -DDROPBEAR_CLIENT=0
    - -DDROPBEAR_METAL=1
    - -DLOCALOPTIONS_H_EXISTS=1
    - -DBUNDLED_LIBTOM=1
    - -DUSE_LTM
    - -DLTM_DESC
    - -U__linux__
    - -Ulinux
    - -U__gnu_linux__

---
# WAMR Metal port — platform_api_vmcore.h / wasm_export.h from external/wamr.
If:
  PathMatch: .*/src/pymergetic/metal/wasm/
CompileFlags:
  Add:
    - -Isrc/pymergetic/metal/wasm/port/platform
    - -Isrc/pymergetic/metal/wasm/port
    - -Iexternal/wamr/core/iwasm/include
    - -Iexternal/wamr/core/iwasm/interpreter
    - -Iexternal/wamr/core/iwasm/common
    - -Iexternal/wamr/core/shared/platform/include
    - -Iexternal/wamr/core/shared/mem-alloc
    - -Iexternal/wamr/core/shared/utils
    - -Iexternal/wamr/core/shared/utils/uncommon
    - -Iexternal/wamr/core
    - -DBH_PLATFORM_METAL
    - -DBUILD_TARGET_X86_64
    - -DWASM_ENABLE_INTERP=1
    - -DWASM_ENABLE_FAST_INTERP=1
    - -DWASM_ENABLE_AOT=0
    - -DWASM_ENABLE_JIT=0
    - -DWASM_ENABLE_FAST_JIT=0
    - -DWASM_ENABLE_LIBC_BUILTIN=0
    - -DWASM_ENABLE_LIBC_WASI=0
    - -DWASM_ENABLE_SIMD=0
    - -DWASM_ENABLE_MULTI_MODULE=0
    - -DWASM_ENABLE_SHARED_MEMORY=0
    - -DWASM_ENABLE_MINI_LOADER=0
    - -DWASM_DISABLE_HW_BOUND_CHECK=1
    - -DWASM_DISABLE_STACK_HW_BOUND_CHECK=1
    - -DWASM_ENABLE_BULK_MEMORY=1
    - -DBH_MALLOC=wasm_runtime_malloc
    - -DBH_FREE=wasm_runtime_free
    - -U__linux__
    - -Ulinux
    - -U__gnu_linux__
Diagnostics:
  UnusedIncludes: None
  MissingIncludes: None

---
# BIOS / private bringup (platform layout).
If:
  PathMatch: .*/src/pymergetic/metal/boot/platform/bios/
CompileFlags:
  Add:
    - -DPM_METAL_BOOT_TARGET_BIOS=1
    - -Isrc/pymergetic/metal/boot/platform/bios

---
If:
  PathMatch: .*/src/pymergetic/metal/boot/platform/private/
CompileFlags:
  Add:
    - -DPM_METAL_BOOT_TARGET_BIOS=1
    - -Isrc/pymergetic/metal/boot/platform/bios

---
# EFI ports.
If:
  PathMatch: .*/src/pymergetic/metal/boot/platform/efi/
CompileFlags:
  Add:
    - --target=x86_64-unknown-windows
    - -fshort-wchar
    - -Wno-macro-redefined
    - -DPM_METAL_BOOT_TARGET_EFI=1
    - -Isrc/pymergetic/metal/boot/platform/efi
    - -Iexternal/edk2/MdePkg/Include
    - -Iexternal/edk2/MdePkg/Include/X64
    - -Iexternal/edk2/MdePkg/Include/Protocol
    - -Iexternal/edk2/MdePkg/Include/Guid

---
# Vendored trees — suppress IncludeCleaner noise.
If:
  PathMatch: external/.*
Diagnostics:
  UnusedIncludes: None
  MissingIncludes: None

---
If:
  PathMatch: .*/external/.*
Diagnostics:
  UnusedIncludes: None
  MissingIncludes: None
