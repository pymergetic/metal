#!/usr/bin/env bash
# Setup — EFI/BIOS freestanding deps (hosted ports archived).
# Usage: scripts/setup <name>
#        scripts/setup all
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DEPS="${ROOT}/scripts/setup.d/deps"
PORT="${ROOT}/scripts/setup.d/port"
# shellcheck disable=SC1091
source "${ROOT}/scripts/lib/run-steps.sh"

usage() {
	cat >&2 <<'EOF'
usage: scripts/setup <name>
       scripts/setup all

Deps (setup.d/deps/):
  edk2         — Tianocore EDK2 + local nasm (required for metal.efi)
  tools        — wasi-sdk + wasmtime into .tools/ (guest mod builds)
  wamr wamrc   — runtime + optional AOT compiler (.tools/wamrc)
  lwip lz4 microtar monocypher mbedtls
  net          — monocypher + mbedtls (lwIP TLS stack)
  micropython  — core scripting VM (shared metal/py; EFI/BIOS link)
  ide          — clangd / compile_flags refresh

Platform:
  efi   — OVMF / toolchain notes
  all   — edk2 + efi
EOF
	exit 1
}

[[ $# -ge 1 ]] || usage
name="$1"
shift

case "${name}" in
-h | --help | help) usage ;;
all)
	[[ $# -eq 0 ]] || usage
	pm_run_steps "${ROOT}/scripts/setup" \
		"edk2" \
		"efi"
	exit $?
	;;
efi)
	exec "${PORT}/efi/default.sh" "$@"
	;;
*)
	script="${DEPS}/${name}.sh"
	if [[ ! -f "${script}" ]]; then
		echo "unknown setup name: ${name}" >&2
		usage
	fi
	exec "${script}" "$@"
	;;
esac
