#!/usr/bin/env bash
# clang-format wrapper for the Metal C dialect (see .clang-format,
# docs/SOURCETREE.md "C dialect" / "Layout — compact, not EDK2-spread").
#
# EDK2-dialect trees (src/efi/**, src/bios/**) and vendored third-party code
# (external/) carry their own `.clang-format` with DisableFormat: true, so
# this is safe to point at the whole repo — those trees are always no-ops.
#
# Usage:
#   scripts/format               format the default trees in place
#   scripts/format check         dry-run + fail if anything would change (CI)
#   scripts/format <path>...     format only these files/dirs
#   scripts/format check <path>...
#
# *.inc.c files (embed_mods.inc.c, py_zip_embed.inc.c, ...) are skipped:
# they're "/* AUTO-GENERATED ... — do not edit */" byte-array dumps, not
# hand-maintained C, and clang-format's own wrapping of a 12-byte-per-line
# hex array doesn't reliably converge to a stable "clean" form anyway.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
	cat >&2 <<'EOF'
usage: scripts/format [check] [<path>...]

  (no args)      clang-format -i the default trees (include/, src/, tests/, mods/)
  check          dry-run: report files that need formatting, exit nonzero if any do
  <path>...      operate on these files/dirs instead of the defaults

Default trees skip src/efi/**, src/bios/**, external/, build/ automatically
(the first two via their own DisableFormat .clang-format, the rest by not
being walked at all). *.inc.c (auto-generated) files are always skipped.
EOF
	exit 1
}

default_paths() {
	printf '%s\n' "${ROOT}/include" "${ROOT}/src" "${ROOT}/tests" "${ROOT}/mods"
}

collect_files() {
	# args: one or more files/dirs
	local p
	for p in "$@"; do
		if [[ -f "${p}" ]]; then
			case "${p}" in
			*.inc.c) ;;
			*) printf '%s\n' "${p}" ;;
			esac
		elif [[ -d "${p}" ]]; then
			find "${p}" \
				\( -path '*/build/*' -o -path '*/external/*' -o -path '*/.git/*' \) -prune -o \
				\( -name '*.inc.c' \) -prune -o \
				\( -name '*.c' -o -name '*.h' \) -print
		fi
	done
}

mode="format"
if [[ "${1:-}" == "check" ]]; then
	mode="check"
	shift
fi
[[ "${1:-}" != "-h" && "${1:-}" != "--help" ]] || usage

if [[ $# -gt 0 ]]; then
	paths=("$@")
else
	mapfile -t paths < <(default_paths)
fi

mapfile -t files < <(collect_files "${paths[@]}")
[[ ${#files[@]} -gt 0 ]] || {
	echo "format: no .c/.h files found under: ${paths[*]}" >&2
	exit 0
}

if [[ "${mode}" == "check" ]]; then
	bad=0
	for f in "${files[@]}"; do
		if ! clang-format --dry-run --Werror "${f}" >/dev/null 2>&1; then
			echo "format: needs formatting: ${f}" >&2
			bad=1
		fi
	done
	if [[ "${bad}" -ne 0 ]]; then
		echo "format: run 'scripts/format' to fix" >&2
		exit 1
	fi
	echo "format: ok (${#files[@]} files)" >&2
else
	clang-format -i "${files[@]}"
	echo "format: formatted ${#files[@]} files" >&2
fi
