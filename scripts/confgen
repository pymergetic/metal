#!/usr/bin/env python3
"""Generate build/autoconf.h + build/config.sh from config/.config (or defconfig)."""
from __future__ import annotations

import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
KLIB = ROOT / "scripts" / "lib" / "kconfig"
sys.path.insert(0, str(KLIB))

import kconfiglib  # noqa: E402

CONFIG_DIR = ROOT / "config"
DOTCONFIG = CONFIG_DIR / ".config"
DEFCONFIG = CONFIG_DIR / "defconfig"
OUT_DIR = ROOT / "build"
AUTOCONF = OUT_DIR / "autoconf.h"
CONFIG_SH = OUT_DIR / "config.sh"

# Menu stores KiB/MiB; C still wants byte CONFIG_* under these aliases.
# name -> (byte_symbol_name, multiplier)
_SIZE_TO_BYTES: dict[str, tuple[str, int]] = {
    "PM_METAL_ASGI_IO_MAX_MIB": ("PM_METAL_ASGI_IO_MAX", 1024 * 1024),
    "PM_METAL_ASGI_HDR_MAX_KIB": ("PM_METAL_ASGI_HDR_MAX", 1024),
    "PM_METAL_IO_WIRE_MAX_KIB": ("PM_METAL_IO_WIRE_MAX", 1024),
    "PM_METAL_TLS_WIRE_MAX_KIB": ("PM_METAL_TLS_WIRE_MAX", 1024),
    "PM_METAL_PY_BLOB_MIB": ("PM_METAL_PY_BLOB_BYTES", 1024 * 1024),
    "PM_METAL_PY_ISOLATED_BLOB_KIB": ("PM_METAL_PY_ISOLATED_BLOB_BYTES", 1024),
}


def main() -> int:
    # Host CPython — typings/os.pyi is the Metal guest stub (no environ/chdir).
    os.environ.setdefault("srctree", str(CONFIG_DIR))  # type: ignore[attr-defined]
    os.chdir(CONFIG_DIR)  # type: ignore[attr-defined]
    kconf = kconfiglib.Kconfig("Kconfig", warn_to_stderr=True)
    if DOTCONFIG.is_file():
        kconf.load_config(str(DOTCONFIG))
    elif DEFCONFIG.is_file():
        kconf.load_config(str(DEFCONFIG))
    else:
        print("confgen: missing config/.config and config/defconfig", file=sys.stderr)
        return 1

    OUT_DIR.mkdir(parents=True, exist_ok=True)

    # C header
    lines = [
        "/* AUTO-GENERATED by scripts/confgen — do not edit */",
        "#ifndef PM_METAL_AUTOCONF_H_",
        "#define PM_METAL_AUTOCONF_H_",
        "",
    ]
    sh = [
        "# AUTO-GENERATED by scripts/confgen — do not edit",
        "# shellcheck shell=bash",
        "",
    ]
    for sym in kconf.unique_defined_syms:
        name = sym.name
        if sym.type == kconfiglib.BOOL or sym.type == kconfiglib.TRISTATE:
            if sym.tri_value == 2:
                lines.append(f"#define CONFIG_{name} 1")
                sh.append(f"export CONFIG_{name}=y")
            else:
                sh.append(f"export CONFIG_{name}=n")
        elif sym.type == kconfiglib.INT:
            val = sym.str_value
            lines.append(f"#define CONFIG_{name} {val}")
            sh.append(f"export CONFIG_{name}={val}")
            scaled = _SIZE_TO_BYTES.get(name)
            if scaled is not None:
                byte_name, mult = scaled
                try:
                    nbytes = int(val, 0) * mult
                except ValueError:
                    print(f"confgen: bad int for {name}={val!r}", file=sys.stderr)
                    return 1
                lines.append(f"#define CONFIG_{byte_name} {nbytes}")
                sh.append(f"export CONFIG_{byte_name}={nbytes}")
        elif sym.type == kconfiglib.HEX:
            val = sym.str_value
            lines.append(f"#define CONFIG_{name} {val}")
            sh.append(f"export CONFIG_{name}={val}")
        elif sym.type == kconfiglib.STRING:
            val = sym.str_value.replace("\\", "\\\\").replace('"', '\\"')
            lines.append(f'#define CONFIG_{name} "{val}"')
            sh.append(f'export CONFIG_{name}="{val}"')

    lines += ["", "#endif /* PM_METAL_AUTOCONF_H_ */", ""]
    AUTOCONF.write_text("\n".join(lines) + "\n")
    CONFIG_SH.write_text("\n".join(sh) + "\n")
    print(f"confgen: {AUTOCONF}")
    print(f"confgen: {CONFIG_SH}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
