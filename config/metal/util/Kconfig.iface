menu "iface"

config PM_METAL_IFACE_EMBED_C_HEADERS
	bool "Embed C header packs (h@metal.guest, ...)"
	default y
	help
	  Bake lz4(ustar) packs via embed-iface.sh: h@metal.guest,
	  meta@metal.guest + meta@metal.guest.docs, and h@mod.t8_multimod_lib.
	  Also always bakes py@metal.stdlib (mandatory for MicroPython).
	  Gates the iface catalog; other Python packs depend on this.

config PM_METAL_IFACE_EMBED_C_IMPL
	bool "Embed full metal C/asm/h impl pack (JIT / rebuild)"
	default n
	depends on PM_METAL_IFACE_EMBED_C_HEADERS
	help
	  Bake c@metal.guest: all .c/.S/.s/.h under
	  src/pymergetic/metal, src/{efi,bios}/pymergetic/metal, and
	  include/pymergetic/metal. Skips *.inc.c (generated embeds). Off by default.

config PM_METAL_IFACE_EMBED_PYTHON_HEADERS
	bool "Embed Python stub packs (pyi@metal.guest)"
	default y
	depends on PM_METAL_IFACE_EMBED_C_HEADERS
	help
	  Bake pyi@metal.guest from typings/. Interface surface for
	  editors; not on MicroPython sys.path.

config PM_METAL_IFACE_EMBED_PYTHON_IMPL
	bool "Embed product Python pack (py@metal.guest)"
	default y
	depends on PM_METAL_IFACE_EMBED_C_HEADERS
	help
	  Bake py@metal.guest: httpd, api, templates, microdot, utemplate
	  in import layout (same as ESP /mods). On by default when the iface
	  catalog is enabled.

endmenu
