menu "py"

config PM_METAL_PY_BLOB_MIB
	int "PM_METAL_PY_BLOB (MiB)"
	default 16
	range 1 64
	help
	  Primary MicroPython heap blob. Catalog: py.PM_METAL_PY_BLOB_BYTES.
	  confgen emits CONFIG_PM_METAL_PY_BLOB_BYTES in bytes.

config PM_METAL_PY_ISOLATED_BLOB_KIB
	int "PM_METAL_PY_ISOLATED_BLOB (KiB)"
	default 256
	range 16 16384
	help
	  Isolated MicroPython session heap. Catalog: py.PM_METAL_PY_ISOLATED_BLOB_BYTES.
	  confgen emits CONFIG_PM_METAL_PY_ISOLATED_BLOB_BYTES in bytes.

endmenu
