# Default Metal config (= today's hardcodes). menuconfig / oldconfig write config/.config.
# Size budgets use KiB/MiB in menu/.config; scripts/confgen emits byte CONFIG_* for C.
CONFIG_PM_METAL_BUILD_EFI=y
# CONFIG_PM_METAL_BUILD_BIOS is not set
# CONFIG_PM_METAL_BUILD_MOD is not set
# CONFIG_PM_METAL_BUILD_ALL is not set
CONFIG_PM_METAL_BIOS_X86_64=y
# CONFIG_PM_METAL_BIOS_I386 is not set
CONFIG_PM_METAL_POST_NONE=y
# CONFIG_PM_METAL_POST_RUN is not set
# CONFIG_PM_METAL_POST_UPLOAD_EFI is not set
# CONFIG_PM_METAL_POST_UPLOAD_PXE is not set
CONFIG_PM_METAL_IO_WIRE_MAX_KIB=1024
CONFIG_PM_METAL_ASGI_IO_MAX_MIB=4
CONFIG_PM_METAL_ASGI_MOUNT_MAX=512
CONFIG_PM_METAL_ASGI_SRV_MAX=16
CONFIG_PM_METAL_ASGI_HDR_MAX_KIB=256
CONFIG_PM_METAL_ASGI_APP_SLOTS=128
CONFIG_PM_METAL_ASGI_PATH_MAX=256
CONFIG_PM_METAL_TLS_WIRE_MAX_KIB=1024
CONFIG_PM_METAL_PY_BLOB_MIB=16
CONFIG_PM_METAL_PY_ISOLATED_BLOB_KIB=256
CONFIG_PM_METAL_IFACE_EMBED_HEADERS=y
# CONFIG_PM_METAL_IFACE_EMBED_SOURCES is not set
