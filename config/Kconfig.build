menu "Build"

comment "Firmware targets — build with: ./forge-cli build [efi|bios|all]"

config PM_METAL_BUILD_EFI
	bool "efi (UEFI metal.efi)"
	default y
	help
	  Build freestanding UEFI Metal (metal.efi) via ./forge-cli build efi.

config PM_METAL_BUILD_BIOS
	bool "bios (Multiboot2 metal.elf)"
	default y
	help
	  Build freestanding Multiboot2 Metal via ./forge-cli build bios.

comment "Follow-ups — run with: ./forge-cli run [efi|bios|all]"

config PM_METAL_POST_RUN
	bool "run (./forge-cli run after build)"
	depends on PM_METAL_BUILD_EFI || PM_METAL_BUILD_BIOS
	default n
	help
	  Hint only for now; invoke ./forge-cli run yourself after build.

endmenu
