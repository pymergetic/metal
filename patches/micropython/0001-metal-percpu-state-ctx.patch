diff --git a/py/mpstate.c b/py/mpstate.c
index 6ce64ad..fe8febe 100644
--- a/py/mpstate.c
+++ b/py/mpstate.c
@@ -30,4 +30,18 @@
 mp_dynamic_compiler_t mp_dynamic_compiler = {0};
 #endif
 
-mp_state_ctx_t mp_state_ctx;
+/*
+ * pymergetic/metal: this used to be the sole `mp_state_ctx` instance. It is
+ * now just the shared/default context's backing storage (context 0);
+ * `mp_state_ctx` itself is a per-CPU indirection macro — see mpstate.h and
+ * src/pymergetic/metal/py/py_ctx.c.
+ */
+mp_state_ctx_t mp_state_ctx_default;
+
+/*
+ * pymergetic/metal: one entry per CPU, populated by pm_metal_py_ctx_table_init()
+ * (py_ctx.c) before anything touches MP_STATE_.../mp_state_ctx. Every slot
+ * defaults to &mp_state_ctx_default until a task claims an isolated context
+ * for the CPU currently running it (pm_metal_py_ctx_enter()).
+ */
+mp_state_ctx_t **mp_metal_py_ctx_table;
diff --git a/py/mpstate.h b/py/mpstate.h
index 54eca59..6ea577a 100644
--- a/py/mpstate.h
+++ b/py/mpstate.h
@@ -307,7 +307,20 @@ typedef struct _mp_state_ctx_t {
     mp_state_mem_t mem;
 } mp_state_ctx_t;
 
-extern mp_state_ctx_t mp_state_ctx;
+/*
+ * pymergetic/metal: `mp_state_ctx` is a per-CPU indirection, not a plain
+ * global — see src/pymergetic/metal/py/py_ctx.c. `mp_state_ctx_default` is
+ * the shared/default context's backing storage (what every CPU's table slot
+ * points at until a task claims an isolated context); `pm_metal_mem_cpu()`
+ * is Metal's race-free "which CPU am I" (runtime/mem/mem.c) — no threads,
+ * no locks: each CPU only ever reads/writes its own table slot. `&mp_state_ctx`
+ * (used by gc.c's root-pointer scan) stays correct under this indirection
+ * because `&*p == p` for any valid pointer expression `p`.
+ */
+extern mp_state_ctx_t   mp_state_ctx_default;
+extern mp_state_ctx_t **mp_metal_py_ctx_table;
+extern unsigned          pm_metal_mem_cpu(void);
+#define mp_state_ctx (*mp_metal_py_ctx_table[pm_metal_mem_cpu()])
 
 #define MP_STATE_VM(x) (mp_state_ctx.vm.x)
 #define MP_STATE_MEM(x) (mp_state_ctx.mem.x)
diff --git a/py/runtime.c b/py/runtime.c
index deb55bf..b996965 100644
--- a/py/runtime.c
+++ b/py/runtime.c
@@ -55,9 +55,19 @@
 #define DEBUG_OP_printf(...) (void)0
 #endif
 
+/*
+ * pymergetic/metal: same reasoning as modsys.c's sys.argv/sys.modules —
+ * MP_STATE_VM(...) can't be a static initializer address under the
+ * per-CPU indirection, so this pins to the shared/default context's
+ * dict_main. Harmless in practice: REPL autocomplete (repl.c, the only
+ * consumer) and `import __main__` only ever run against the shared
+ * context in this design (isolated contexts are non-interactive, see
+ * py_ctx.h) — actual script execution resolves globals via
+ * mp_globals_get()/MP_STATE_THREAD, which stays correctly per-context.
+ */
 const mp_obj_module_t mp_module___main__ = {
     .base = { &mp_type_module },
-    .globals = (mp_obj_dict_t *)&MP_STATE_VM(dict_main),
+    .globals = (mp_obj_dict_t *)&mp_state_ctx_default.vm.dict_main,
 };
 
 MP_REGISTER_MODULE(MP_QSTR___main__, mp_module___main__);
