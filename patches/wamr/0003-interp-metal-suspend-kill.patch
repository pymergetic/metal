diff --git a/core/iwasm/interpreter/wasm_interp_classic.c b/core/iwasm/interpreter/wasm_interp_classic.c
index 9f7e03e2..d2fa91ec 100644
--- a/core/iwasm/interpreter/wasm_interp_classic.c
+++ b/core/iwasm/interpreter/wasm_interp_classic.c
@@ -1432,6 +1432,8 @@ wasm_interp_call_func_import(WASMModuleInstance *module_inst,
 #define SUSPENSION_UNLOCK()
 #endif
 
+/* Metal freestanding: no host yield from the interp loop. */
+#define PM_METAL_WAMR_YIELD() ((void)0)
 #define CHECK_SUSPEND_FLAGS()                                         \
     do {                                                              \
         WASM_SUSPEND_FLAGS_LOCK(exec_env->wait_lock);                 \
@@ -1441,6 +1443,13 @@ wasm_interp_call_func_import(WASMModuleInstance *module_inst,
             WASM_SUSPEND_FLAGS_UNLOCK(exec_env->wait_lock);           \
             return;                                                   \
         }                                                             \
+        /* pymergetic/metal: best-effort unlocked read of             \
+         * module->cur_exception (WASMModuleInstance*). terminate()   \
+         * may set only this on search_exec_env miss (no TERMINATE). */ \
+        if (module->cur_exception[0] != '\0') {                       \
+            WASM_SUSPEND_FLAGS_UNLOCK(exec_env->wait_lock);           \
+            return;                                                   \
+        }                                                             \
         while (WASM_SUSPEND_FLAGS_GET(exec_env->suspend_flags)        \
                & WASM_SUSPEND_FLAG_SUSPEND) {                         \
             /* suspend current thread */                              \
@@ -1449,6 +1458,9 @@ wasm_interp_call_func_import(WASMModuleInstance *module_inst,
             SUSPENSION_UNLOCK()                                       \
         }                                                             \
         WASM_SUSPEND_FLAGS_UNLOCK(exec_env->wait_lock);               \
+        /* pymergetic/metal: let the controller run kill()/wait() on   \
+         * native_sim while a guest is in a pure compute loop. */     \
+        PM_METAL_WAMR_YIELD();                                        \
     } while (0)
 #endif /* WASM_ENABLE_DEBUG_INTERP */
 #endif /* WASM_ENABLE_THREAD_MGR */
diff --git a/core/iwasm/interpreter/wasm_interp_fast.c b/core/iwasm/interpreter/wasm_interp_fast.c
index 1c744f9a..7b40192b 100644
--- a/core/iwasm/interpreter/wasm_interp_fast.c
+++ b/core/iwasm/interpreter/wasm_interp_fast.c
@@ -1379,6 +1379,8 @@ wasm_interp_call_func_import(WASMModuleInstance *module_inst,
 #endif
 
 #if WASM_ENABLE_THREAD_MGR != 0
+/* Metal freestanding: no host yield from the interp loop. */
+#define PM_METAL_WAMR_YIELD_FAST() ((void)0)
 #define CHECK_SUSPEND_FLAGS()                               \
     do {                                                    \
         WASM_SUSPEND_FLAGS_LOCK(exec_env->wait_lock);       \
@@ -1388,8 +1390,17 @@ wasm_interp_call_func_import(WASMModuleInstance *module_inst,
             WASM_SUSPEND_FLAGS_UNLOCK(exec_env->wait_lock); \
             return;                                         \
         }                                                   \
+        /* pymergetic/metal: best-effort unlocked read of   \
+         * module->cur_exception — same as classic. */      \
+        if (module->cur_exception[0] != '\0') {             \
+            WASM_SUSPEND_FLAGS_UNLOCK(exec_env->wait_lock); \
+            return;                                         \
+        }                                                   \
         /* TODO: support suspend and breakpoint */          \
         WASM_SUSPEND_FLAGS_UNLOCK(exec_env->wait_lock);     \
+        /* pymergetic/metal: let controller run kill/wait   \
+         * while a guest is in a hot loop. */               \
+        PM_METAL_WAMR_YIELD_FAST();                         \
     } while (0)
 #endif
 
