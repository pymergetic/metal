diff --git a/src/svr-authsslcert.c b/src/svr-authsslcert.c
new file mode 100644
index 0000000..8aa0a71
--- /dev/null
+++ b/src/svr-authsslcert.c
@@ -0,0 +1,69 @@
+/*
+ * Metal X.509 SSH userauth extension.
+ *
+ * Wire payload after the standard SSH_MSG_USERAUTH_REQUEST fields:
+ *   boolean has_signature (must be TRUE)
+ *   string  client certificate DER
+ *   string  DER-encoded X.509-key signature
+ *
+ * The signature covers the normal SSH public-key proof preimage:
+ * string(session_id) || userauth payload through the certificate string.
+ */
+#include "includes.h"
+#include "buffer.h"
+#include "dbutil.h"
+#include "packet.h"
+#include "runopts.h"
+#include "session.h"
+
+void svr_auth_sslcert(int valid_user)
+{
+	unsigned char has_signature;
+	unsigned char *cert;
+	unsigned char *signature;
+	unsigned int cert_len;
+	unsigned int signature_len;
+	unsigned int signed_payload_len;
+	buffer *signed_data;
+	int ok;
+
+	has_signature = buf_getbool(ses.payload);
+	cert_len = buf_getint(ses.payload);
+	cert = buf_getptr(ses.payload, cert_len);
+	signed_payload_len = ses.payload->pos - ses.payload_beginning;
+	signature = buf_getstring(ses.payload, &signature_len);
+	signed_data = NULL;
+	ok = 0;
+
+	if (valid_user && has_signature) {
+		extern int metal_dropbear_auth_sslcert(const char *requested_user,
+			const unsigned char *cert_der, unsigned int cert_len,
+			const unsigned char *signed_data, unsigned int signed_len,
+			const unsigned char *signature, unsigned int signature_len);
+
+		signed_data = buf_new(signed_payload_len + 4 + ses.session_id->len);
+		buf_putbufstring(signed_data, ses.session_id);
+		buf_setpos(ses.payload, ses.payload_beginning);
+		buf_putbytes(signed_data, buf_getptr(ses.payload, signed_payload_len),
+			signed_payload_len);
+		buf_setpos(signed_data, 0);
+		ok = metal_dropbear_auth_sslcert(ses.authstate.pw_name, cert, cert_len,
+			signed_data->data, signed_data->len, signature, signature_len);
+	}
+
+	if (signed_data != NULL) {
+		buf_free(signed_data);
+	}
+	m_free(signature);
+	if (!ok) {
+		send_msg_userauth_failure(0, 1);
+		return;
+	}
+
+	if (svr_opts.multiauthmethod && (ses.authstate.authtypes & ~AUTH_TYPE_SSLCERT)) {
+		ses.authstate.authtypes &= ~AUTH_TYPE_SSLCERT;
