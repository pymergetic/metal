[BuildOptions]
  GCC:*_*_*_DLINK_FLAGS = -Wl,-T,$(MODULE_DIR)/shell_cmds.lds
  GCC:*_*_*_CC_FLAGS = -DMICROPY_USE_INTERNAL_ERRNO=1 -I/home/ladmin/Devel/os-sdk/packages/metal/external/micropython -I/home/ladmin/Devel/os-sdk/packages/metal/build/micropython_embed/genhdr -I/home/ladmin/Devel/os-sdk/packages/metal/build/micropython_embed/port -I/home/ladmin/Devel/os-sdk/packages/metal/build/micropython_embed -I/home/ladmin/Devel/os-sdk/packages/metal/src/pymergetic/metal/py/embed -I/home/ladmin/Devel/os-sdk/packages/metal/build/trust -I/home/ladmin/Devel/os-sdk/packages/metal -I/home/ladmin/Devel/os-sdk/packages/metal/src/pymergetic/metal/dev/gfx -I/home/ladmin/Devel/os-sdk/packages/metal/src/pymergetic/metal/bus/pci -I/home/ladmin/Devel/os-sdk/packages/metal/src/pymergetic/metal/dev/net -I/home/ladmin/Devel/os-sdk/packages/metal/src/pymergetic/metal/dev/net/bge -I/home/ladmin/Devel/os-sdk/packages/metal/external/lwip/src/include -I/home/ladmin/Devel/os-sdk/packages/metal/external/mbedtls/include -I/home/ladmin/Devel/os-sdk/packages/metal/src/pymergetic/metal/runtime/mem/host_stubs -I/home/ladmin/Devel/os-sdk/packages/metal/src/pymergetic/metal/guest/wamr -I/home/ladmin/Devel/os-sdk/packages/metal/src/pymergetic/metal -I/home/ladmin/Devel/os-sdk/packages/metal/include -I/home/ladmin/Devel/os-sdk/packages/metal/external/tlsf -I/home/ladmin/Devel/os-sdk/packages/metal/external/microtar/src -I/home/ladmin/Devel/os-sdk/packages/metal/external/wamr/core/iwasm/include -I/home/ladmin/Devel/os-sdk/packages/metal/external/wamr/core/iwasm/interpreter -I/home/ladmin/Devel/os-sdk/packages/metal/external/wamr/core/iwasm/aot -I/home/ladmin/Devel/os-sdk/packages/metal/external/wamr/core/iwasm/common -I/home/ladmin/Devel/os-sdk/packages/metal/external/wamr/core/iwasm/libraries/libc-wasi -I/home/ladmin/Devel/os-sdk/packages/metal/external/wamr/core/iwasm/libraries/libc-wasi/sandboxed-system-primitives/include -I/home/ladmin/Devel/os-sdk/packages/metal/external/wamr/core/iwasm/libraries/libc-wasi/sandboxed-system-primitives/src -I/home/ladmin/Devel/os-sdk/packages/metal/external/wamr/core/shared/platform/include -I/home/ladmin/Devel/os-sdk/packages/metal/external/wamr/core/shared/mem-alloc -I/home/ladmin/Devel/os-sdk/packages/metal/external/wamr/core/shared/utils -I/home/ladmin/Devel/os-sdk/packages/metal/external/wamr/core/shared/utils/uncommon -DMBEDTLS_CONFIG_FILE=\"pymergetic/metal/dev/net/mbedtls_metal_config.h\" -DBUILD_TARGET_X86_64 -DBH_PLATFORM_METAL_EFI -DAPP_THREAD_STACK_SIZE_DEFAULT=6144 -DAPP_THREAD_STACK_SIZE_MIN=4096 -U__linux__ -Ulinux -U__gnu_linux__ -DWASM_ENABLE_INTERP=1 -DWASM_ENABLE_FAST_INTERP=1 -DWASM_ENABLE_AOT=1 -DWASM_ENABLE_LIBC_WASI=1 -DWASM_ENABLE_MULTI_MODULE=0 -DWASM_ENABLE_BULK_MEMORY=1 -DWASM_ENABLE_SHARED_MEMORY=0 -DWASM_ENABLE_MINI_LOADER=0 -DWASM_DISABLE_HW_BOUND_CHECK=1 -DWASM_DISABLE_STACK_HW_BOUND_CHECK=1 -DWASM_DISABLE_WAKEUP_BLOCKING_OP=0 -DWASM_GLOBAL_HEAP_SIZE=50331648 -DWASM_ENABLE_MODULE_INST_CONTEXT=1 -DWASM_ENABLE_QUICK_AOT_ENTRY=1 -DWASM_ENABLE_AOT_INTRINSICS=1 -DWASM_ENABLE_SHRUNK_MEMORY=1 -DWASM_ENABLE_EXTENDED_CONST_EXPR=0 -DBH_MALLOC=wasm_runtime_malloc -DBH_FREE=wasm_runtime_free -Wno-error -Wno-unused-parameter -Wno-sign-compare -Wno-missing-field-initializers -Wno-format -fno-strict-aliasing
