menu "fs"

config PM_METAL_FS_ROOT_SIZE_MIB
	int "Root FAT size (MiB)"
	range 1 256
	default 4
	help
	  Size of the kernel Stage-A rootfs image mounted at "/".
	  Embedded in the firmware binary; seeded with etc/, tmp/, mods/, src/.
	  Keep small unless you need a large RW root.

choice
	prompt "Kernel source pack (/src/<id>)"
	default PM_METAL_FS_SRC_MODE_HUMAN
	help
	  What to embed under /src/<kernel module id>.
	  Built by: tools/forge build (forge img rootfs).

config PM_METAL_FS_SRC_MODE_NONE
	bool "none - do not embed/mount /src"
	help
	  Skip packing and mounting /src/<kernel id>.

config PM_METAL_FS_SRC_MODE_HUMAN
	bool "human only - forge originals (no generated faces)"
	help
	  Pack forge originals only. Skip files with the forge banner
	  "DO NOT HAND-EDIT THIS FILE."

config PM_METAL_FS_SRC_MODE_ALL
	bool "human + generated - include forge banner faces"
	help
	  Pack human sources plus forge-generated faces.

endchoice

config PM_METAL_FS_KERNEL_MODULE_ID
	string "Kernel module id (mount path segment)"
	default "pymergetic.metal"
	help
	  Dotted module id used for /mods/<id> and /src/<id>.

config PM_METAL_FS_MOUNT_KERNEL_MODS
	bool "Embed and mount /mods/<kernel id>"
	default y

config PM_METAL_FS_MOUNT_KERNEL_SRC
	bool "Embed and mount /src/<kernel id> (when mode != none)"
	default y
	depends on !PM_METAL_FS_SRC_MODE_NONE

config PM_METAL_FS_KERNEL_MODS_SEED
	string "Optional seed directory for kernel mods mtar (relative to exp2)"
	default ""
	depends on PM_METAL_FS_MOUNT_KERNEL_MODS
	help
	  If empty, an empty mtar is embedded.

endmenu
