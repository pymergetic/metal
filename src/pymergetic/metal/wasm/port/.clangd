# Generic fallback when CDB misses these TUs. -I relative to this dir.
# Matches wasm/.pm/build.rs freestanding includes (WAMR + Metal platform).
CompileFlags:
  Add:
    - -xc
    - -std=c11
    - -ffreestanding
    - -nostdinc
    - -m64
    - -mno-red-zone
    - -Iplatform
    - -I.
    - -I../../libc
    - -I../../../../
    - -I../../../../../external/wamr/core/iwasm/include
    - -I../../../../../external/wamr/core/iwasm/interpreter
    - -I../../../../../external/wamr/core/iwasm/common
    - -I../../../../../external/wamr/core/shared/platform/include
    - -I../../../../../external/wamr/core/shared/mem-alloc
    - -I../../../../../external/wamr/core/shared/utils
    - -I../../../../../external/wamr/core/shared/utils/uncommon
    - -I../../../../../external/wamr/core
    - -DBH_PLATFORM_METAL
    - -DBUILD_TARGET_X86_64
    - -DWASM_ENABLE_INTERP=1
    - -DWASM_ENABLE_FAST_INTERP=1
    - -DWASM_ENABLE_AOT=0
    - -DWASM_ENABLE_JIT=0
    - -DWASM_ENABLE_LIBC_BUILTIN=0
    - -DWASM_ENABLE_LIBC_WASI=0
    - -DWASM_DISABLE_HW_BOUND_CHECK=1
    - -DWASM_ENABLE_BULK_MEMORY=1
Diagnostics:
  UnusedIncludes: None
  MissingIncludes: None
