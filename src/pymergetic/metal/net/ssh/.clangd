# Generic fallback when CDB misses these TUs. -I relative to this dir.
# Stubs before libc — matches .pm/build.rs Glue freestanding flags.
CompileFlags:
  Add:
    - -xc
    - -std=gnu11
    - -ffreestanding
    - -nostdinc
    - -m64
    - -mno-red-zone
    - -Idropbear_stubs
    - -I../../libc
    - -I.
    - -Idropbear_metal
    - -I../../../../../external/dropbear/src
    - -I../../../../
    - -I../..
    - -DDROPBEAR_SERVER=1
    - -DDROPBEAR_CLIENT=0
    - -DDROPBEAR_METAL=1
    - -DLOCALOPTIONS_H_EXISTS=1
    - -DBUNDLED_LIBTOM=1
    - -DUSE_LTM
    - -DLTM_DESC
Diagnostics:
  UnusedIncludes: None
  MissingIncludes: None
