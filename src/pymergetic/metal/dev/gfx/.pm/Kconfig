menu "gfx"

config PM_METAL_GFX_SCANOUT_VIRTIO_GPU
	bool "virtio_gpu scanout (QEMU virtio-gpu-pci)"
	default y
	help
	  Probe virtio-gpu RESOURCE_FLUSH present. QEMU opt-in device via
	  METAL_SCANOUT_VIRTIO_GPU=1 on forge run.

config PM_METAL_GFX_SCANOUT_BOCHS
	bool "bochs_flip scanout (QEMU stdvga DISPI)"
	default y
	help
	  Bochs/QEMU stdvga VBE virt_h page-flip. Default forge -vga std path.

config PM_METAL_GFX_SCANOUT_RADEON
	bool "radeon_rv370 scanout (ThinkPad T43 1002:5460)"
	default y
	help
	  Iron RV370 GART/CP + staging MMIO blit. Not exercised on QEMU
	  (unverified until real hardware).

config PM_METAL_GFX_SCANOUT_I915
	bool "i915_855gm scanout (ThinkPad T42 8086:3582 sample)"
	default y
	help
	  Sample Gen2 Intel GGTT + ring blit + DSPAADDR flip. Not exercised
	  on QEMU (unverified until real hardware).

config PM_METAL_GFX_SCANOUT_GOP
	bool "gop_blt scanout (pre-EBS EFI GOP Blt)"
	default y
	help
	  Pre-ExitBootServices EFI Graphics Output Blt present.

config PM_METAL_GFX_SCANOUT_LFB
	bool "lfb_copy scanout (chunked shadow->LFB memcpy)"
	default y
	help
	  Generic owned-framebuffer fallback (chunked memcpy).

config PM_METAL_GFX_UI_BOOT_STRIPE
	bool "Paint boot status stripe after gfx present"
	default y
	help
	  After detect/present, draw a bottom status line with the bound
	  scanout name (minimal UI consumer of the compositor). Real #ifdef
	  / rustc-cfg via gfx/.pm/build.rs reading build/autoconf.h.

endmenu
