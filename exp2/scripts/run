#!/usr/bin/env bash
# Run exp2 firmware under QEMU (bios and/or efi peers).
#   ./exp2/scripts/run          -> bios then efi
#   ./exp2/scripts/run bios
#   ./exp2/scripts/run efi
set -euo pipefail

EXP2="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ROOT="$(cd "${EXP2}/.." && pwd)"
TARGET="${1:-all}"
# Logical runners sized from MADT; QEMU should expose multiple CPUs.
SMP="${EXP2_SMP:-4}"
VBLK="${EXP2}/build/vblk.img"

find_ovmf() {
	local cand
	for cand in \
		/usr/share/ovmf/OVMF.fd \
		/usr/share/OVMF/OVMF.fd \
		/usr/share/OVMF/OVMF_CODE_4M.fd
	do
		if [[ -f "${cand}" ]]; then
			printf '%s\n' "${cand}"
			return 0
		fi
	done
	return 1
}

ensure_vblk() {
	mkdir -p "$(dirname "${VBLK}")"
	if [[ ! -f "${VBLK}" ]]; then
		# Small raw image for virtio-blk PCI presence (detect only).
		dd if=/dev/zero of="${VBLK}" bs=1M count=8 status=none
	fi
}

# Shared virtio devices for harvest DT (net/blk/console/input).
virtio_args() {
	ensure_vblk
	printf '%s\n' \
		-netdev user,id=n0 \
		-device virtio-net-pci,netdev=n0 \
		-drive if=none,id=vd0,format=raw,file="${VBLK}" \
		-device virtio-blk-pci,drive=vd0 \
		-chardev null,id=vcon \
		-device virtio-serial-pci,max_ports=1 \
		-device virtconsole,chardev=vcon \
		-device virtio-tablet-pci
}

# QEMU isa-debug-exit: exit code ((value << 1) | 1). Treat 1 as success.
normalize_qemu_ec() {
	local ec="$1"
	if [[ "${ec}" -eq 1 ]]; then
		return 0
	fi
	return "${ec}"
}

run_bios() {
	local ELF="${EXP2}/build/x86_64_bios/metal.qemu.elf"
	local -a VIO
	if [[ ! -f "${ELF}" ]]; then
		echo "exp2/scripts/run: missing ${ELF} - run ./exp2/scripts/build bios" >&2
		exit 1
	fi
	mapfile -t VIO < <(virtio_args)
	echo "exp2/scripts/run: bios ${ELF}" >&2
	set +e
	qemu-system-x86_64 \
		-machine q35,accel=kvm:tcg \
		-smp "${SMP}" \
		-m 512 \
		-display none \
		-device isa-debug-exit,iobase=0x501,iosize=0x02 \
		-serial stdio \
		"${VIO[@]}" \
		-kernel "${ELF}"
	local ec=$?
	set -e
	normalize_qemu_ec "${ec}"
}

run_efi() {
	local EFI_IMG="${EXP2}/build/x86_64_efi/metal.efi"
	local ESP="${EXP2}/build/x86_64_efi/esp"
	local OVMF
	local -a VIO

	if [[ ! -f "${EFI_IMG}" ]]; then
		echo "exp2/scripts/run: missing ${EFI_IMG} - run ./exp2/scripts/build efi" >&2
		exit 1
	fi
	OVMF="$(find_ovmf)" || {
		echo "exp2/scripts/run: OVMF not found (apt: ovmf)" >&2
		exit 1
	}

	rm -rf "${ESP}"
	mkdir -p "${ESP}/EFI/BOOT"
	cp -f "${EFI_IMG}" "${ESP}/EFI/BOOT/BOOTX64.EFI"
	mapfile -t VIO < <(virtio_args)

	echo "exp2/scripts/run: efi ${EFI_IMG} (OVMF ${OVMF})" >&2
	set +e
	# Timeout: bringup should finish quickly; avoid hanging on OVMF shell.
	timeout --signal=KILL 25s qemu-system-x86_64 \
		-machine q35,accel=kvm:tcg \
		-smp "${SMP}" \
		-m 512 \
		-display none \
		-device isa-debug-exit,iobase=0x501,iosize=0x02 \
		-serial stdio \
		"${VIO[@]}" \
		-drive if=pflash,format=raw,readonly=on,file="${OVMF}" \
		-drive format=raw,file=fat:rw:"${ESP}" \
		-boot order=d
	local ec=$?
	set -e
	if [[ "${ec}" -eq 124 || "${ec}" -eq 137 ]]; then
		echo "exp2/scripts/run: efi qemu timed out" >&2
		return 1
	fi
	normalize_qemu_ec "${ec}"
}

case "${TARGET}" in
bios | x86_64)
	run_bios
	;;
efi)
	run_efi
	;;
all | both)
	run_bios
	run_efi
	;;
*)
	echo "exp2/scripts/run: unsupported target ${TARGET} (bios|efi|all)" >&2
	exit 1
	;;
esac
