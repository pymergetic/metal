# Build outputs
/build/
/exp2/build/

# Cargo outs (host tools + module crates; modules also list these locally)
**/.target/
**/target/

# Local Kconfig selections (defaults: config/defconfig)
/config/.config
/config/.config.old

# Legacy layout leftovers
host/**/build/
host/**/images/
runtime/**/build/
runtime/**/images/
runtime/**/bench/build/
mods/build/

# Toolchain (local download)
.tools/

# Vendored / generated trees (most deps are setup-cloned + ignored)
/external/*
# Engine fork — tracked (submodule or worktree); not vanilla micropython
!/external/metal-python/
!/external/metal-python/**

# IDE / tooling
.vscode/
.idea/
.cache/
.venv/
compile_commands.json
**/compile_commands.json
cmake-build-*/

# Generated from .clangd.template by scripts/setup ide
/.clangd

# EFI artifacts (legacy flat name; images live under /build/)
/*.efi

# Generated from src/efi/MetalPkg/*.inf.tpl (@METAL_ROOT@ → checkout root)
/src/efi/MetalPkg/Metal.inf
/src/efi/MetalPkg/DropbearGlue.inf


# Leftover product zip names (no longer built; keep ignored if present)
/mods/httpd/microdot.zip
/mods/httpd/microdot.zip.sig
/mods/httpd/utemplate.zip
/mods/api/api.zip
/mods/api/templates.zip

# utemplate compile_templates.py output (from templates/*.html)
/mods/api/templates/*_html.py

# Python bytecode
**/__pycache__/
*.py[cod]

# Build-generated byte-array / table embeds (regenerated every build;
# never hand-edit). Hand-authored *.inc.c assets (fonts, trust tables,
# firmware blobs) stay tracked.
/src/pymergetic/metal/guest/wasm/embed_mods.inc.c
/src/pymergetic/metal/util/iface_syms.inc.c
/src/pymergetic/metal/util/iface_metal_guest_embed.inc.c

# wamrc temp stack-usage dumps (cwd leftovers)
wamrc-su-*.su
