build/

# Cargo output for this crate (metal is its own crate now).
target/

# clangd database — absolute -I paths naming one checkout (make compile-commands).
compile_commands.json

# Host CPython bytecode from running inspect / microdot .py next to the cards.
__pycache__/
*.pyc

# Bytes from inspect/www/. Recreate with tools/embed_www.py (every seat's make).
# Lives in the metal root ignore so wasmmod-gen cannot wipe a card .gitignore.
www_embed.inc.h

# Bytes from each card's C/Rust muscle source. Recreate with tools/embed_src.py
# (every seat's make), same shape as www_embed.inc.h above.
src_embed.inc.h

# Stage 1 zenoh-pico standalone prove build outputs (tools/zp_pico_prove).
tools/zp_pico_prove/.build/
tools/zp_pico_prove/prove_pub
tools/zp_pico_prove/prove_sub
