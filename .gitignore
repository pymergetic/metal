# Build outputs
/build/

# Legacy layout leftovers
host/**/build/
host/**/images/
runtime/**/build/
runtime/**/images/
runtime/**/bench/build/
mods/build/

# Toolchain (local download)
.tools/

# Vendored / generated trees
/external/

# IDE / tooling
.vscode/
.idea/
.cache/
.venv/
compile_commands.json
**/compile_commands.json
cmake-build-*/

# Generated from .clangd.template by scripts/setup ide
/.clangd

# EFI artifacts
/*.efi
/build/efi/

# stdlib.zip + its .sig are rebuilt+resigned from mods/py/stdlib_src/ on
# every build (scripts/build.d/port/efi/embed-stdlib.sh) and baked into the
# firmware image as generated C byte arrays — see docs/MICROPYTHON.md. The
# .sig is never byte-stable across re-signs, so none of this is tracked.
/mods/py/stdlib.zip
/mods/py/stdlib.zip.sig
/src/pymergetic/metal/py/py_zip_embed.inc.c

# Build-generated byte-array / table embeds (regenerated every build;
# never hand-edit). Hand-authored *.inc.c assets (fonts, trust tables,
# firmware blobs) stay tracked.
/src/pymergetic/metal/guest/wasm/embed_mods.inc.c
/src/pymergetic/metal/util/iface_syms.inc.c
/src/pymergetic/metal/util/iface_metal_guest_embed.inc.c

# wamrc temp stack-usage dumps (cwd leftovers)
wamrc-su-*.su
