# Build outputs
/build/

# Local Kconfig selections (defaults: config/defconfig)
/config/.config
/config/.config.old

# Legacy layout leftovers
host/**/build/
host/**/images/
runtime/**/build/
runtime/**/images/
runtime/**/bench/build/
mods/build/

# Toolchain (local download)
.tools/

# Vendored / generated trees
/external/

# IDE / tooling
.vscode/
.idea/
.cache/
.venv/
compile_commands.json
**/compile_commands.json
cmake-build-*/

# Generated from .clangd.template by scripts/setup ide
/.clangd

# EFI artifacts
/*.efi
/build/efi/

# Guest Python zips + sigs — rebuilt from source on every ESP/PXE stage
# (embed-stdlib.sh / build_microdot_zip.sh / pack_asgi_zips.sh). .sig is
# never byte-stable across re-signs. Track sources only (stdlib_src/,
# microdot_src submodule, templates/*.html, utemplate/*.py).
/mods/py/stdlib.zip
/mods/py/stdlib.zip.sig
/mods/py/microdot.zip
/mods/py/microdot.zip.sig
/mods/py/templates.zip
/mods/py/utemplate.zip

# utemplate compile_templates.py output (from templates/*.html)
/mods/py/templates/*_html.py

# Python bytecode
**/__pycache__/
*.py[cod]

/src/pymergetic/metal/py/py_zip_embed.inc.c

# Build-generated byte-array / table embeds (regenerated every build;
# never hand-edit). Hand-authored *.inc.c assets (fonts, trust tables,
# firmware blobs) stay tracked.
/src/pymergetic/metal/guest/wasm/embed_mods.inc.c
/src/pymergetic/metal/util/iface_syms.inc.c
/src/pymergetic/metal/util/iface_metal_guest_embed.inc.c

# wamrc temp stack-usage dumps (cwd leftovers)
wamrc-su-*.su
