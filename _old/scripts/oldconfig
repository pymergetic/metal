#!/usr/bin/env python3
"""Refresh config/.config after Kconfig changes (non-interactive defaults for new symbols)."""
from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
KLIB = ROOT / "scripts" / "lib" / "kconfig"
CONFIG_DIR = ROOT / "config"
DOTCONFIG = CONFIG_DIR / ".config"
DEFCONFIG = CONFIG_DIR / "defconfig"

sys.path.insert(0, str(KLIB))
import kconfiglib  # noqa: E402


def main() -> int:
    # Host CPython — typings/os.pyi is the Metal guest stub (no environ).
    os.environ.setdefault("srctree", str(CONFIG_DIR))  # type: ignore[attr-defined]
    os.chdir(CONFIG_DIR)  # type: ignore[attr-defined]
    kconf = kconfiglib.Kconfig("Kconfig")
    path = DOTCONFIG if DOTCONFIG.is_file() else DEFCONFIG
    if not path.is_file():
        print("oldconfig: no .config or defconfig", file=sys.stderr)
        return 1
    kconf.load_config(str(path))
    # Assign defaults to any missing symbols by rewriting
    kconf.write_config(str(DOTCONFIG))
    print(f"oldconfig: wrote {DOTCONFIG}")
    return subprocess.call([str(ROOT / "scripts" / "confgen")])


if __name__ == "__main__":
    sys.exit(main())
