#!/usr/bin/env bash
# Build interface — EFI freestanding Metal + guest artifacts.
# Defaults from Kconfig (config/.config); argv/env override for this call only.
# Usage: scripts/build [<target> [all|i386|x86_64]]
#        scripts/build all
#        scripts/build          # uses CONFIG_PM_METAL_BUILD_* / BIOS_* checkboxes
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PORT="${ROOT}/scripts/build.d/port"
GUEST="${ROOT}/scripts/build.d/guest"
# shellcheck disable=SC1091
source "${ROOT}/scripts/lib/run-steps.sh"
# shellcheck disable=SC1091
source "${ROOT}/scripts/lib/kconfig.sh"

usage() {
	cat >&2 <<'EOF'
usage: scripts/build [<target> [all|i386|x86_64]]
       scripts/build all

  With no args, builds every Kconfig checkbox that is enabled
  (efi / bios / mod, plus bios x86_64 / i386 — scripts/menuconfig).

  efi       — freestanding UEFI Metal (scaffold → metal.efi)
  bios      — freestanding Multiboot2 Metal (→ metal.elf)
              optional: bios i386 | bios x86_64 (else all enabled BIOS archs)
  mod       — guest wasm tests
  all       — mod + efi + bios (all enabled BIOS archs)

Examples:
  scripts/build
  scripts/build all
  scripts/build efi
  scripts/build bios
  scripts/build bios i386
  scripts/build mod

See docs/KCONFIG.md for menuconfig / override order.
EOF
	exit 1
}

run_script() {
	local script="$1"
	shift
	if [[ ! -f "${script}" ]]; then
		echo "missing ${script}" >&2
		exit 1
	fi
	"${script}" "$@"
}

pm_metal_kconfig_load

# --- resolve target list: argv > env > .config checkboxes ---
plat_mode=""
bios_arch_argv=""
declare -a plats=()
declare -a bios_archs=()

if [[ $# -ge 1 ]]; then
	case "$1" in
	-h | --help | help) usage ;;
	efi | bios | mod | all)
		plat_mode="$1"
		shift
		;;
	*) usage ;;
	esac
fi

if [[ -z "${plat_mode}" ]]; then
	if [[ "${PM_METAL_BUILD_TARGET:-}" != "" ]]; then
		plat_mode="${PM_METAL_BUILD_TARGET}"
	else
		[[ "${CONFIG_PM_METAL_BUILD_MOD:-n}" == "y" ]] && plats+=("mod")
		[[ "${CONFIG_PM_METAL_BUILD_EFI:-n}" == "y" ]] && plats+=("efi")
		[[ "${CONFIG_PM_METAL_BUILD_BIOS:-n}" == "y" ]] && plats+=("bios")
		if [[ ${#plats[@]} -eq 0 ]]; then
			echo "build: no target selected (enable efi/bios/mod in menuconfig)" >&2
			exit 1
		elif [[ ${#plats[@]} -eq 1 ]]; then
			plat_mode="${plats[0]}"
		else
			plat_mode="multi"
		fi
	fi
fi

case "${plat_mode}" in
efi | mod)
	plats=("${plat_mode}")
	if [[ $# -ge 1 ]]; then
		[[ "$1" == "all" && $# -eq 1 ]] || usage
		shift
	fi
	;;
bios)
	plats=("bios")
	if [[ $# -ge 1 ]]; then
		case "$1" in
		all) [[ $# -eq 1 ]] || usage; shift ;;
		i386 | x86_64) bios_arch_argv="$1"; shift; [[ $# -eq 0 ]] || usage ;;
		*) usage ;;
		esac
	fi
	;;
all)
	[[ $# -eq 0 ]] || usage
	plats=("mod" "efi" "bios")
	;;
multi)
	[[ $# -eq 0 ]] || usage
	;;
*) usage ;;
esac

need_bios=0
for p in "${plats[@]}"; do
	[[ "${p}" == "bios" ]] && need_bios=1
done

if [[ "${need_bios}" -eq 1 ]]; then
	if [[ -n "${bios_arch_argv}" ]]; then
		bios_archs=("${bios_arch_argv}")
	elif [[ "${PM_METAL_BIOS_ARCH:-}" != "" ]]; then
		bios_archs=("${PM_METAL_BIOS_ARCH}")
	else
		[[ "${CONFIG_PM_METAL_BIOS_X86_64:-n}" == "y" ]] && bios_archs+=("x86_64")
		[[ "${CONFIG_PM_METAL_BIOS_I386:-n}" == "y" ]] && bios_archs+=("i386")
		# Argv `bios` / `all` with no arch checkbox yet → x86_64.
		if [[ ${#bios_archs[@]} -eq 0 ]]; then
			if [[ "${plat_mode}" == "bios" || "${plat_mode}" == "all" ]]; then
				bios_archs=("x86_64")
			else
				echo "build: bios enabled but no arch selected (x86_64 / i386 in menuconfig)" >&2
				exit 1
			fi
		fi
	fi
fi

# Expand to concrete steps (bios may be one or two archs).
declare -a steps=()
for p in "${plats[@]}"; do
	if [[ "${p}" == "bios" ]]; then
		local_a=
		for local_a in "${bios_archs[@]}"; do
			steps+=("bios ${local_a}")
		done
	else
		steps+=("${p}")
	fi
done

do_build_one() {
	local one="$1"
	case "${one}" in
	efi) run_script "${PORT}/efi/default.sh" ;;
	mod) run_script "${GUEST}/mod.sh" ;;
	bios\ *)
		run_script "${PORT}/bios/default.sh" "${one#bios }"
		;;
	*)
		echo "build: unknown target '${one}'" >&2
		exit 1
		;;
	esac
}

do_build() {
	local s
	if [[ ${#steps[@]} -eq 1 ]]; then
		do_build_one "${steps[0]}"
		return
	fi
	# Multiple steps: child scripts/build must not re-run POST_* actions.
	PM_METAL_POST_ACTION=none pm_run_steps "${ROOT}/scripts/build" "${steps[@]}"
}

do_build

# What this invocation actually built (not only Kconfig cosmetics).
built_efi=0
built_bios=0
built_mod=0
for s in "${steps[@]}"; do
	case "${s}" in
	efi) built_efi=1 ;;
	mod) built_mod=1 ;;
	bios\ *) built_bios=1 ;;
	esac
done
built_any=0
[[ ${#steps[@]} -gt 0 ]] && built_any=1

# Same gates as config/Kconfig.build depends on (stale .config / env cannot bypass).
post_ok_upload_efi() { [[ "${built_efi}" -eq 1 ]]; }
post_ok_upload_pxe() { [[ "${built_bios}" -eq 1 ]]; }
post_ok_run() { [[ "${built_any}" -eq 1 ]]; }

# Post-actions from Kconfig checkboxes (any combination). Env:
#   PM_METAL_POST_ACTION=none          — skip all
#   PM_METAL_POST_ACTION=run|upload-*  — only that one (still gated)
post_env="${PM_METAL_POST_ACTION:-}"
declare -a posts=()
if [[ "${post_env}" == "none" ]]; then
	posts=()
elif [[ -n "${post_env}" ]]; then
	posts=("${post_env}")
else
	if [[ "${CONFIG_PM_METAL_POST_UPLOAD_EFI:-n}" == "y" ]] && post_ok_upload_efi; then
		posts+=("upload-efi")
	fi
	if [[ "${CONFIG_PM_METAL_POST_UPLOAD_PXE:-n}" == "y" ]] && post_ok_upload_pxe; then
		posts+=("upload-pxe")
	fi
	if [[ "${CONFIG_PM_METAL_POST_RUN:-n}" == "y" ]] && post_ok_run; then
		posts+=("run")
	fi
fi

run_post() {
	local post="$1"
	local primary=""
	case "${post}" in
	none | "") return 0 ;;
	upload-efi)
		if ! post_ok_upload_efi; then
			echo "build: post upload-efi skipped (efi not in this build)" >&2
			return 0
		fi
		"${ROOT}/scripts/upload-efi"
		;;
	upload-pxe)
		if ! post_ok_upload_pxe; then
			echo "build: post upload-pxe skipped (bios not in this build)" >&2
			return 0
		fi
		"${ROOT}/scripts/upload-pxe"
		;;
	run)
		if ! post_ok_run; then
			echo "build: post run skipped (nothing built)" >&2
			return 0
		fi
		# scripts/run only knows efi|bios; prefer efi then bios.
		if [[ "${built_efi}" -eq 1 ]]; then
			primary="efi"
		elif [[ "${built_bios}" -eq 1 ]]; then
			primary="bios"
		else
			echo "build: post run skipped (only mod built; scripts/run needs efi|bios)" >&2
			return 0
		fi
		"${ROOT}/scripts/run" "${primary}"
		;;
	*)
		echo "build: unknown post action '${post}'" >&2
		exit 1
		;;
	esac
}

for post in "${posts[@]}"; do
	run_post "${post}"
done
