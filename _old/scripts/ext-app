#!/usr/bin/env bash
# One-shot dev round-trip for an external app (see scripts/lib/ext-apps.sh):
# build it (by convention: <dir>/scripts/build.sh, staged from
# <dir>/build/<name>), then run whichever of build/upload/run you ask for,
# on whichever of efi/bios you ask for. Metal itself never builds or signs
# the app -- that stays the app repo's job.
#
# Steps (combinable, short flags stack: -bur == -b -u -r):
#   -b / --build    build the app (unless --no-build) + build Metal for the
#                   selected platform(s). With no platform selected, just
#                   builds the app and stops.
#   -u / --upload   efi: stage the ESP + scp it to your host (scripts/upload-efi).
#                   bios: scp i386_bios + build/pxe/ to your PXE/TFTP host
#                   (scripts/upload-pxe).
#   -r / --run      launch interactively in QEMU (scripts/run efi|bios).
#   -s / --all-steps  shorthand for -bur (all 3 steps).
#
# Platforms: -e/--efi, -i/--bios, -a/--all (shorthand for -ei, both platforms).
#
# Usage: scripts/ext-app <name>=<dir>[:name2=dir2...] \
#          [-b|--build] [-u|--upload] [-r|--run] [-s|--all-steps] \
#          [-e|--efi] [-i|--bios] [-a|--all] \
#          [--no-build] [--build-cmd 'cmd'] [-- extra-args...]
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
	cat >&2 <<'EOF'
usage: scripts/ext-app <name>=<dir>[:name2=dir2...] [-b|--build] [-u|--upload] [-r|--run] [-s|--all-steps]
                        [-e|--efi] [-i|--bios] [-a|--all] [--no-build] [--build-cmd 'cmd']
                        [-- extra-args...]

  Short flags stack: -bur == -b -u -r, -bea == -b -e -a (etc).

Steps:
  -b, --build     build the app (dir/scripts/build.sh, unless --no-build) +
                   scripts/build for each selected platform. No platform
                   selected -> just builds the app and stops.
  -u, --upload    efi: scripts/upload-efi (stage ESP + scp to your host).
                   bios: scripts/upload-pxe (scp to your TFTP host).
  -r, --run       scripts/run efi|bios (interactive QEMU). extra-args (after
                   --) are forwarded, e.g. --bench, --vnc 2.
                   Note: bios run (SeaBIOS -kernel, local QEMU testing) does
                   NOT see staged external apps -- only the i386/PXE build
                   (-u) does.
  -s, --all-steps shorthand for -bur (build + upload + run)

Platforms:
  -e, --efi       select EFI
  -i, --bios      select BIOS
  -a, --all       shorthand for -ei (both platforms) -- steps are separate,
                   see -s/--all-steps above

App:
  <name>=<dir>    dir is normally the app's repo root (sibling checkout);
                   dir/scripts/build.sh is run and the app staged from
                   dir/build/name. If dir/scripts/build.sh doesn't exist,
                   dir is used as an already-built output dir as-is.
  --no-build      skip calling the app's scripts/build.sh even if present
                   (reuse the last build)
  --build-cmd cmd escape hatch: run this instead of the scripts/build.sh
                   convention; every name=dir is then a literal,
                   already-built output dir (same as --no-build)

Examples:
  scripts/ext-app doom=../metal-doom -b            # just build the app
  scripts/ext-app doom=../metal-doom -ber           # build + run efi
  scripts/ext-app doom=../metal-doom -beu           # build + upload efi (ESP)
  scripts/ext-app doom=../metal-doom -biu           # build + upload bios (PXE)
  scripts/ext-app doom=../metal-doom -sa            # build+upload+run, efi+bios
  scripts/ext-app doom=../metal-doom -er -- --bench # run efi (no rebuild), headless
EOF
	exit 1
}

# Split "name=dir[:name2=dir2...]" into resolved "name=stage_dir[:...]",
# running each dir's scripts/build.sh convention unless do_build=0. Sets
# RESOLVED_APPS (not an echo'd return value) -- build.sh's own stdout must
# reach the real terminal live, not get captured by a command substitution.
resolve_apps() {
	local spec="$1" do_build="$2"
	local entries=() resolved=()
	local entry name dir build_script

	IFS=':' read -ra entries <<<"${spec}"
	for entry in "${entries[@]}"; do
		[[ -z "${entry}" ]] && continue
		name="${entry%%=*}"
		dir="${entry#*=}"
		if [[ -z "${name}" || -z "${dir}" || "${name}" == "${entry}" ]]; then
			echo "ext-app: skip malformed entry '${entry}' (want name=dir)" >&2
			resolved+=("${entry}")
			continue
		fi

		build_script="${dir}/scripts/build.sh"
		if [[ -f "${build_script}" ]]; then
			if [[ "${do_build}" -eq 1 ]]; then
				echo "ext-app: build -- ${build_script}" >&2
				"${build_script}"
			fi
			dir="${dir}/build/${name}"
		fi
		resolved+=("${name}=${dir}")
	done

	local IFS=':'
	RESOLVED_APPS="${resolved[*]}"
}

[[ $# -ge 1 ]] || usage
case "$1" in
-h | --help | help) usage ;;
esac
apps="$1"
[[ -n "${apps}" && "${apps}" != -* ]] || usage
shift

want_build=0
want_upload=0
want_run=0
want_efi=0
want_bios=0
want_all=0
want_all_steps=0
no_build=0
build_cmd=""
extra_args=()

while [[ $# -gt 0 ]]; do
	arg="$1"
	case "${arg}" in
	--)
		shift
		extra_args=("$@")
		break
		;;
	-h | --help | help) usage ;;
	--build) want_build=1 ;;
	--upload) want_upload=1 ;;
	--run) want_run=1 ;;
	--all-steps) want_all_steps=1 ;;
	--efi) want_efi=1 ;;
	--bios) want_bios=1 ;;
	--all) want_all=1 ;;
	--no-build) no_build=1 ;;
	--build-cmd)
		[[ $# -ge 2 ]] || usage
		build_cmd="$2"
		shift
		;;
	-*)
		rest="${arg#-}"
		[[ -n "${rest}" ]] || usage
		for ((k = 0; k < ${#rest}; k++)); do
			c="${rest:k:1}"
			case "${c}" in
			b) want_build=1 ;;
			u) want_upload=1 ;;
			r) want_run=1 ;;
			s) want_all_steps=1 ;;
			e) want_efi=1 ;;
			i) want_bios=1 ;;
			a) want_all=1 ;;
			*)
				echo "ext-app: unknown flag -${c} (in ${arg})" >&2
				usage
				;;
			esac
		done
		;;
	*)
		echo "ext-app: unexpected arg '${arg}'" >&2
		usage
		;;
	esac
	shift
done

if [[ "${want_all}" -eq 1 ]]; then
	want_efi=1
	want_bios=1
fi
if [[ "${want_all_steps}" -eq 1 ]]; then
	want_build=1
	want_upload=1
	want_run=1
fi

if [[ "${want_build}" -eq 0 && "${want_upload}" -eq 0 && "${want_run}" -eq 0 ]]; then
	echo "ext-app: pick at least one step: -b/--build, -u/--upload, -r/--run (or -s/--all-steps)" >&2
	usage
fi
if [[ "${want_efi}" -eq 0 && "${want_bios}" -eq 0 ]]; then
	if [[ "${want_upload}" -eq 1 || "${want_run}" -eq 1 ]]; then
		echo "ext-app: -u/--upload and -r/--run need a platform: -e/--efi, -i/--bios, or -a/--all" >&2
		usage
	fi
fi

if [[ -n "${build_cmd}" ]]; then
	echo "ext-app: build -- ${build_cmd}" >&2
	bash -c "${build_cmd}"
	resolved_apps="${apps}"
else
	resolve_apps "${apps}" "$([[ "${want_build}" -eq 1 && "${no_build}" -eq 0 ]] && echo 1 || echo 0)"
	resolved_apps="${RESOLVED_APPS}"
fi

export METAL_EXT_APPS="${resolved_apps}"
echo "ext-app: METAL_EXT_APPS=${METAL_EXT_APPS}" >&2

if [[ "${want_build}" -eq 1 ]]; then
	if [[ "${want_efi}" -eq 1 ]]; then
		echo "ext-app: build efi" >&2
		"${ROOT}/scripts/build" efi
	fi
	if [[ "${want_bios}" -eq 1 ]]; then
		echo "ext-app: build bios i386 (PXE tree)" >&2
		"${ROOT}/scripts/build" bios i386
	fi
fi

if [[ "${want_upload}" -eq 1 ]]; then
	if [[ "${want_efi}" -eq 1 ]]; then
		if [[ "${want_build}" -eq 1 ]]; then
			"${ROOT}/scripts/upload-efi"
		else
			"${ROOT}/scripts/upload-efi" --build
		fi
	fi
	if [[ "${want_bios}" -eq 1 ]]; then
		if [[ "${want_build}" -eq 1 ]]; then
			"${ROOT}/scripts/upload-pxe"
		else
			"${ROOT}/scripts/upload-pxe" --build
		fi
	fi
fi

if [[ "${want_run}" -eq 1 ]]; then
	if [[ "${want_efi}" -eq 1 ]]; then
		"${ROOT}/scripts/run" efi "${extra_args[@]}"
	fi
	if [[ "${want_bios}" -eq 1 ]]; then
		echo "ext-app: run-bios is local SeaBIOS QEMU testing -- external apps aren't staged there (PXE/-u only)" >&2
		"${ROOT}/scripts/run" bios "${extra_args[@]}"
	fi
fi
