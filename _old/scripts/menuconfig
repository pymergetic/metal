#!/usr/bin/env python3
"""Interactive Metal menuconfig (vendored Kconfiglib). Writes config/.config then confgen."""
from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
KLIB = ROOT / "scripts" / "lib" / "kconfig"
CONFIG_DIR = ROOT / "config"
DOTCONFIG = CONFIG_DIR / ".config"
DEFCONFIG = CONFIG_DIR / "defconfig"

sys.path.insert(0, str(KLIB))


def main() -> int:
    # Host CPython — typings/os.pyi is the Metal guest stub (no environ).
    os.environ.setdefault("srctree", str(CONFIG_DIR))  # type: ignore[attr-defined]
    os.chdir(CONFIG_DIR)  # type: ignore[attr-defined]
    if not DOTCONFIG.is_file() and DEFCONFIG.is_file():
        DOTCONFIG.write_bytes(DEFCONFIG.read_bytes())

    # menuconfig.py as library entry
    import kconfiglib
    import menuconfig as mc

    kconf = kconfiglib.Kconfig("Kconfig")
    if DOTCONFIG.is_file():
        kconf.load_config(str(DOTCONFIG))
    mc.menuconfig(kconf)
    # Persist + regenerate headers for the next build
    kconf.write_config(str(DOTCONFIG))
    return subprocess.call([str(ROOT / "scripts" / "confgen")])


if __name__ == "__main__":
    sys.exit(main())
