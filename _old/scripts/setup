#!/usr/bin/env bash
# Archived vendor setup (reference only — not the live front door).
# Usage: _old/scripts/setup <name>
#        _old/scripts/setup all
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DEPS="${HERE}/setup.d/deps"
PORT="${HERE}/setup.d/port"
# shellcheck disable=SC1091
source "${HERE}/lib/run-steps.sh"

usage() {
	cat >&2 <<'EOF'
usage: _old/scripts/setup <name>
       _old/scripts/setup all

Archived deps (setup.d/deps/):
  edk2 tools wamr wamrc lwip lz4 microtar monocypher mbedtls
  net micropython ide microdot utemplate crypt_blowfish dropbear

Platform:
  efi   - OVMF / toolchain notes
  all   - edk2 + efi
EOF
	exit 1
}

[[ $# -ge 1 ]] || usage
name="$1"
shift

case "${name}" in
-h | --help | help) usage ;;
all)
	[[ $# -eq 0 ]] || usage
	pm_run_steps "${HERE}/setup" \
		"edk2" \
		"efi"
	exit $?
	;;
efi)
	exec "${PORT}/efi/default.sh" "$@"
	;;
*)
	script="${DEPS}/${name}.sh"
	if [[ ! -f "${script}" ]]; then
		echo "unknown setup name: ${name}" >&2
		usage
	fi
	exec "${script}" "$@"
	;;
esac
