#!/usr/bin/env bash
# Upload Metal i386 PXE drop to OpenWrt TFTP root.
# Usage: scripts/upload-pxe [--build]
#
# Defaults (override with env):
#   METAL_PXE_HOST=192.168.10.1
#   METAL_PXE_USER=root
#   METAL_PXE_PATH=/storage/tftp
#   METAL_PXE_SSH_OPTS=   # e.g. -i ~/.ssh/openwrt
#   METAL_EXT_APPS=       # with --build: also stage external apps, e.g.
#                         #   name=dir[:name2=dir2...] (see scripts/lib/ext-apps.sh)
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ELF="${ROOT}/build/i386_bios/metal.elf"
PXE="${ROOT}/build/pxe"
HOST="${METAL_PXE_HOST:-192.168.10.1}"
USER="${METAL_PXE_USER:-root}"
DEST="${METAL_PXE_PATH:-/storage/tftp}"
SSH_EXTRA="${METAL_PXE_SSH_OPTS:-}"
BUILD=0

usage() {
	cat >&2 <<'EOF'
usage: scripts/upload-pxe [--build]

  Copy build/i386_bios/metal.elf + build/pxe/{metal.ipxe[,mods/]} → USER@HOST:DEST

  --build   run ./scripts/build bios i386 first
            (set METAL_EXT_APPS=name=dir to include an external app under
            mods/apps/<name>/, e.g. METAL_EXT_APPS=doom=../metal-doom/build/doom)

Env:
  METAL_PXE_HOST      default 192.168.10.1
  METAL_PXE_USER      default root
  METAL_PXE_PATH      default /storage/tftp
  METAL_PXE_SSH_OPTS  extra ssh/scp options (e.g. -i ~/.ssh/openwrt)
  METAL_EXT_APPS      name=dir[:name2=dir2...] external apps to stage for PXE HTTP seed
EOF
	exit 1
}

while [[ $# -gt 0 ]]; do
	case "$1" in
	-h | --help | help) usage ;;
	--build) BUILD=1 ;;
	*) usage ;;
	esac
	shift
done

if [[ "${BUILD}" -eq 1 ]]; then
	"${ROOT}/scripts/build" bios i386
fi

if [[ ! -f "${ELF}" || ! -f "${PXE}/metal.ipxe" ]]; then
	echo "upload-pxe: missing ${ELF} or ${PXE}/metal.ipxe — run: ./scripts/build bios i386" >&2
	exit 1
fi

TARGET="${USER}@${HOST}:${DEST}/"
HTTP="http://${HOST}:8080/"
echo "upload-pxe: ${ELF} + ${PXE}/metal.ipxe → ${TARGET}"
if [[ -d "${PXE}/mods" ]]; then
	echo "upload-pxe: ${PXE}/mods/ → ${TARGET}mods/" >&2
fi
echo "upload-pxe: HTTP mirror (OpenWrt already exports TFTP dir): ${HTTP}"

# OpenWrt: no rsync, often no sftp-server → force legacy SCP (-O).
# shellcheck disable=SC2086
scp -O ${SSH_EXTRA} \
	"${ELF}" "${PXE}/metal.ipxe" \
	"${TARGET}"
if [[ -f "${ELF}.sig" ]]; then
	# shellcheck disable=SC2086
	scp -O ${SSH_EXTRA} "${ELF}.sig" "${TARGET}"
fi

if [[ -d "${PXE}/mods" ]]; then
	# OpenSSH scp rejects trailing "/." ; tar|ssh is reliable on OpenWrt (no rsync/sftp).
	# shellcheck disable=SC2086
	tar -C "${PXE}" -cf - mods | ssh ${SSH_EXTRA} "${USER}@${HOST}" \
		"mkdir -p '${DEST}' && tar -C '${DEST}' -xf -"
fi

# shellcheck disable=SC2086
ssh ${SSH_EXTRA} "${USER}@${HOST}" \
	"ls -la '${DEST}/metal.elf' '${DEST}/metal.ipxe'; \
	 if [ -d '${DEST}/mods/apps' ]; then ls -la '${DEST}/mods/apps'; fi"

echo "upload-pxe: ok — verify ${HTTP}metal.elf"
if [[ -d "${PXE}/mods/apps" ]]; then
	shopt -s nullglob
	for app_dir in "${PXE}"/mods/apps/*/; do
		app_name="$(basename "${app_dir}")"
		# Report every staged file (wasm/aot/sig/wad/assets.list/...), not
		# just a couple of extensions — the tar upload ships all of them
		# regardless, this loop is only the human-readable confirmation.
		for f in "${app_dir}"*; do
			[[ -f "${f}" ]] || continue
			echo "upload-pxe: ${app_name} -> ${HTTP}mods/apps/${app_name}/$(basename "${f}")" >&2
		done
	done
	shopt -u nullglob
fi
