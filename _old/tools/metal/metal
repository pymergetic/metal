#!/usr/bin/env python3
"""Metal unified CLI entry — see docs/TOOLING.md.

Only this launcher owns the asyncio runner. Command implementations are
async; tiny helpers may stay sync.
"""
from __future__ import annotations

import sys
from pathlib import Path

_ROOT = Path(__file__).resolve().parent
if str(_ROOT) not in sys.path:
    sys.path.insert(0, str(_ROOT))

from metal_cli.cli import main

if __name__ == "__main__":
    raise SystemExit(main())
