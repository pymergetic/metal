/dts-v1/;

/ {
	description = "FIT image with Linux kernel, FDT blob and resource";
	#address-cells = <1>;

	images {
		fdt {
			description = "rv1106";
			data = /incbin/("rv1106.dtb");
			type = "flat_dt";
			arch = "arm";
			compression = "none";
			load = <0xffffff00>;
			hash {
				algo = "sha256";
			};
		};
		kernel {
			description = "metal";
			data = /incbin/("metal.bin");
			type = "kernel";
			arch = "arm";
			os = "linux";
			compression = "none";
			load = <0xffffff01>;
			entry = <0xffffff01>;
			hash {
				algo = "sha256";
			};
		};
		resource {
			description = "resource";
			data = /incbin/("resource.img");
			type = "multi";
			arch = "arm";
			compression = "none";
			hash {
				algo = "sha256";
			};
		};
	};

	configurations {
		default = "conf";
		conf {
			description = "metal";
			rollback-index = <0x00>;
			fdt = "fdt";
			kernel = "kernel";
			multi = "resource";
		};
	};
};
