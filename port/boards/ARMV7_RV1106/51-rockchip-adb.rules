# Rockchip USB gadget (Luckfox ADB/RNDIS 2207:0019) and Maskrom.
# Install:
#   sudo cp port/boards/ARMV7_RV1106/51-rockchip-adb.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger -s usb
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="2207", MODE="0666", GROUP="plugdev", TAG+="uaccess"
